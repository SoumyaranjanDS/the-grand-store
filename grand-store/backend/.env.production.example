# Required runtime configuration
NODE_ENV=production
PORT=5015
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@HOST/DATABASE?retryWrites=true&w=majority
JWT_SECRET=replace-with-at-least-32-random-bytes

# Public URLs and CORS (comma-separated, no trailing slash)
ALLOWED_ORIGINS=https://grandstore.co.za,https://www.grandstore.co.za
FRONTEND_URL=https://grandstore.co.za
CLIENT_URL=https://grandstore.co.za
PUBLIC_SITE_URL=https://grandstore.co.za
BACKEND_URL=https://grandstore.co.za
CIGAR_SITE_URL=https://cigar.yogapranafitness.com
CIGAR_LOGO_URL=https://cigar.yogapranafitness.com/images/cigar-connoisseur-logo.png
CIGAR_REPLY_TO=

# Required because the application seeds these privileged accounts at startup
ACCOUNTANT_NAME=Grand Store Accountant
ACCOUNTANT_EMAIL=
ACCOUNTANT_PASSWORD=replace-with-a-unique-random-password
PRODUCT_MANAGER_NAME=Grand Store Product Manager
PRODUCT_MANAGER_EMAIL=
PRODUCT_MANAGER_PASSWORD=replace-with-a-different-random-password

# Cloudinary
CLOUDINARY_API_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=The Grand Store

# Google authentication / APIs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_API_KEY=

# PayFast: use test mode until a complete test payment succeeds
PAYFAST_IS_LIVE=false
PAYFAST_TEST_MERCHANT_ID=
PAYFAST_TEST_MERCHANT_KEY=
PAYFAST_TEST_PASSPHRASE=
PAYFAST_LIVE_MERCHANT_ID=
PAYFAST_LIVE_MERCHANT_KEY=
PAYFAST_LIVE_PASSPHRASE=

# Optional chatbot providers
CHATBOT_AI_PROVIDERS=
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=

# Other application settings
EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4/latest/USD
SUPPORT_WHATSAPP=
EVENT_TIMEZONE_OFFSET=+02:00
EVENT_RESERVATION_MINUTES=30
EVENT_BANK_TRANSFER_RESERVATION_HOURS=24
