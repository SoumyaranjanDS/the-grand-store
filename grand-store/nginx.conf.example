# Grand Store frontend and API on one HTTPS origin.
# Copy/adapt this file in /etc/nginx/sites-available/grandstore.co.za.

server {
    listen 80;
    listen [::]:80;
    server_name grandstore.co.za www.grandstore.co.za;
    return 301 https://grandstore.co.za$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name grandstore.co.za www.grandstore.co.za;

    ssl_certificate /etc/letsencrypt/live/grandstore.co.za/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/grandstore.co.za/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    root /var/www/grand-store/current/frontend;
    index index.html;
    client_max_body_size 50M;

    location ^~ /api/ {
        proxy_pass http://127.0.0.1:5015;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 120s;
    }

    location ^~ /uploads/ {
        proxy_pass http://127.0.0.1:5015;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~* \.(?:css|js|mjs|png|jpe?g|gif|ico|svg|webp|woff2?|ttf|eot|mp4|webm)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    gzip on;
    gzip_min_length 1000;
    gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml;
}
