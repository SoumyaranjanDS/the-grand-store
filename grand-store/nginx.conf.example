# ==============================================================================
# Grand Store - Nginx Production Reverse Proxy Configuration
# Server: 191.215.37.241 (Ubuntu 24.04 LTS)
# ==============================================================================

# 1. Backend API (Reverse Proxy to Node.js / PM2 on Port 5015)
server {
    server_name api.grandstoreglobal.com store-api.yogapranafitness.com;
    client_max_body_size 50M;

    location / {
        proxy_pass http://127.0.0.1:5015;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_cache_bypass $http_upgrade;
    }

    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/grandstoreglobal.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/grandstoreglobal.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

# HTTP to HTTPS Redirect for Backend API
server {
    listen 80;
    server_name api.grandstoreglobal.com store-api.yogapranafitness.com;
    return 301 https://$host$request_uri;
}

# 2. Frontend React / Vite Application (Static Files)
server {
    server_name grandstoreglobal.com www.grandstoreglobal.com grandstore.yogapranafitness.com;

    root /var/www/grandstore-all/grand-store/frontend/dist;
    index index.html;

    # Gzip Compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml;
    gzip_min_length 1000;

    # Static Assets Caching
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|webp)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # SPA Client Routing Fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/grandstoreglobal.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/grandstoreglobal.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

# HTTP to HTTPS Redirect for Frontend
server {
    listen 80;
    server_name grandstoreglobal.com www.grandstoreglobal.com grandstore.yogapranafitness.com;
    return 301 https://$host$request_uri;
}
